{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relay.local/schemas/pose-landmark-sequence-v1.json",
  "title": "Relay pose landmark sequence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "recordingId", "frames"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "recordingId": { "type": "string" },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "timestampMs",
          "frameWidth",
          "frameHeight",
          "image",
          "world"
        ],
        "properties": {
          "timestampMs": { "type": "number", "minimum": 0 },
          "frameWidth": { "type": "integer", "minimum": 1 },
          "frameHeight": { "type": "integer", "minimum": 1 },
          "image": {
            "type": "object",
            "additionalProperties": { "$ref": "#/$defs/landmark" }
          },
          "world": {
            "type": "object",
            "additionalProperties": { "$ref": "#/$defs/landmark" }
          },
          "providerLatencyMs": { "type": "number", "minimum": 0 }
        }
      }
    }
  },
  "$defs": {
    "landmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z", "visibility", "presence"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" },
        "visibility": { "type": "number", "minimum": 0, "maximum": 1 },
        "presence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
