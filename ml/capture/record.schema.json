{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relay.local/schemas/motion-capture-record-v1.json",
  "title": "Relay motion capture record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordingId",
    "origin",
    "participant",
    "consent",
    "exercise",
    "side",
    "camera",
    "poseProvider",
    "files",
    "annotations"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "recordingId": { "type": "string", "minLength": 6 },
    "origin": { "enum": ["recorded-human", "synthetic"] },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pseudonymousId"],
      "properties": {
        "pseudonymousId": { "type": "string", "minLength": 4 },
        "cohortTags": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obtained", "protocolId", "allowedUses"],
      "properties": {
        "obtained": { "const": true },
        "protocolId": { "type": "string", "minLength": 1 },
        "allowedUses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "model-development",
              "held-out-evaluation",
              "internal-replay"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "exercise": {
      "enum": [
        "heel-slide",
        "straight-leg-raise",
        "seated-knee-extension"
      ]
    },
    "side": { "enum": ["left", "right"] },
    "split": { "enum": ["train", "validation", "held_out", "unassigned"] },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deviceClass",
        "orientation",
        "view",
        "distanceBand",
        "width",
        "height",
        "fps"
      ],
      "properties": {
        "deviceClass": { "type": "string" },
        "orientation": { "enum": ["landscape", "portrait"] },
        "view": {
          "enum": ["side", "oblique", "front", "rear", "unknown"]
        },
        "distanceBand": { "enum": ["close", "standard", "far"] },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "mirroredPreview": { "type": "boolean" }
      }
    },
    "poseProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "model", "version"],
      "properties": {
        "name": { "type": "string" },
        "model": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["landmarks", "landmarksSha256"],
      "properties": {
        "video": { "type": "string" },
        "videoSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "landmarks": { "type": "string" },
        "landmarksSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "annotations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "annotatorId",
        "phaseSegments",
        "repetitions",
        "qualitySegments",
        "constraintEvents"
      ],
      "properties": {
        "annotatorId": { "type": "string" },
        "phaseSegments": {
          "type": "array",
          "items": { "$ref": "#/$defs/phaseSegment" }
        },
        "repetitions": {
          "type": "array",
          "items": { "$ref": "#/$defs/repetition" }
        },
        "qualitySegments": {
          "type": "array",
          "items": { "$ref": "#/$defs/qualitySegment" }
        },
        "constraintEvents": {
          "type": "array",
          "items": { "$ref": "#/$defs/constraintEvent" }
        },
        "angleReference": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "units", "samples"],
          "properties": {
            "method": { "type": "string" },
            "units": { "const": "degrees" },
            "synchronized": { "type": "boolean" },
            "samples": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["timestampMs", "kneeFlexion"],
                "properties": {
                  "timestampMs": { "type": "number", "minimum": 0 },
                  "kneeFlexion": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 180
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "interval": {
      "type": "object",
      "required": ["startMs", "endMs"],
      "properties": {
        "startMs": { "type": "number", "minimum": 0 },
        "endMs": { "type": "number", "minimum": 0 }
      }
    },
    "phaseSegment": {
      "allOf": [
        { "$ref": "#/$defs/interval" },
        {
          "type": "object",
          "required": ["phase"],
          "properties": {
            "phase": {
              "enum": ["ready", "moving", "holding", "returning", "paused"]
            }
          }
        }
      ]
    },
    "repetition": {
      "allOf": [
        { "$ref": "#/$defs/interval" },
        {
          "type": "object",
          "required": ["index", "complete"],
          "properties": {
            "index": { "type": "integer", "minimum": 1 },
            "complete": { "type": "boolean" },
            "holdStartMs": { "type": "number", "minimum": 0 },
            "holdEndMs": { "type": "number", "minimum": 0 }
          }
        }
      ]
    },
    "qualitySegment": {
      "allOf": [
        { "$ref": "#/$defs/interval" },
        {
          "type": "object",
          "required": ["quality", "reason"],
          "properties": {
            "quality": {
              "enum": ["good", "caution", "unreliable", "unavailable"]
            },
            "reason": { "type": "string" }
          }
        }
      ]
    },
    "constraintEvent": {
      "type": "object",
      "required": ["timestampMs", "kind", "metric"],
      "properties": {
        "timestampMs": { "type": "number", "minimum": 0 },
        "kind": {
          "enum": ["approaching", "reached", "exceeded", "uncertain"]
        },
        "metric": { "type": "string" },
        "value": { "type": "number" },
        "referenceValue": { "type": "number" }
      }
    }
  }
}
